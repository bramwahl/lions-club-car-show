{
  "name": "lions-club-car-show",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:inspect": "node --env-file=.env.local --env-file-if-exists=.car-show-private/native.env --import tsx scripts/phase1a/cli.ts inspect",
    "db:migrate": "node --env-file=.env.local --env-file-if-exists=.car-show-private/native.env --import tsx scripts/phase1a/cli.ts migrate",
    "db:import": "node --env-file=.env.local --env-file-if-exists=.car-show-private/native.env --import tsx scripts/phase1a/cli.ts import",
    "db:validate": "node --env-file=.env.local --env-file-if-exists=.car-show-private/native.env --import tsx scripts/phase1a/cli.ts validate",
    "db:source": "node --env-file=.env.local --env-file-if-exists=.car-show-private/native.env --import tsx scripts/phase1a/cli.ts source",
    "db:staging-test": "node --env-file=.env.local --env-file-if-exists=.car-show-private/native.env --import tsx scripts/phase1a/staging-tests.ts",
    "db:restore-native": "node --env-file=.env.local --env-file-if-exists=.car-show-private/native.env --import tsx scripts/phase1a/restore-native.ts",
    "auth:bootstrap": "node --env-file=.env.local --env-file-if-exists=.car-show-private/native.env --import tsx scripts/phase1b/bootstrap.ts",
    "auth:validate": "node --env-file=.env.local --env-file-if-exists=.car-show-private/native.env --import tsx scripts/phase1b/validate.ts",
    "auth:test-live": "node --env-file=.env.local --env-file-if-exists=.car-show-private/native.env --import tsx scripts/phase1b/live-tests.ts",
    "auth:test-http": "node --env-file=.env.local --env-file-if-exists=.car-show-private/native.env --import tsx scripts/phase1b/http-tests.ts",
    "workflows:validate": "node --env-file=.env.local --env-file-if-exists=.car-show-private/native.env --import tsx scripts/workflows/validate.ts",
    "workflows:test-http": "node --env-file=.env.local --env-file-if-exists=.car-show-private/native.env --import tsx scripts/workflows/http-tests.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "mariadb": "^3.5.4",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
